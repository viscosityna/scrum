{
  "name": "scrumtime-cli",
  "version": "0.1.17",
  "description": "Command-line client for scrumtime (Viscosity NA internal timesheet/project app)",
  "type": "module",
  "bin": {
    "scrum": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/scrum.cjs"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "conf": "^13.0.1",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
